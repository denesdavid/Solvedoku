<UserControl
    x:Class="Solvedoku.Views.JigsawSudoku.UcJigsawSudoku"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Extensions="clr-namespace:Solvedoku.UI.Extensions"
    xmlns:Converters="clr-namespace:Solvedoku.UI.Converters"
    xmlns:JigsawSudokuViewModels="clr-namespace:Solvedoku.ViewModels.JigsawSudoku"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfx="http://schemas.xceed.com/wpf/xaml/toolkit"
    d:DesignHeight="500"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <JigsawSudokuViewModels:JigsawSudokuViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../BusyIndicatorContent/BusyIndicatorResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <wpfx:BusyIndicator BusyContent="{Binding BusyIndicatorContent, UpdateSourceTrigger=PropertyChanged}" IsBusy="{Binding IsBusy, UpdateSourceTrigger=PropertyChanged}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right">
                <Label Margin="4,4,4,0" Content="{Extensions:Localize Main_JigsawColor}" />
                <wpfx:ColorPicker
                    Margin="8"
                    Opened="ColorPicker_Opened"
                    SelectedColor="{Binding SelectedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ShowAvailableColors="False"
                    ShowTabHeaders="False"
                    StandardColors="{Binding JigsawColors}"
                    StandardColorsHeader="{Extensions:Localize Main_AvailableJigsawColors}"
                    Style="{DynamicResource PuzzleColorPickerStyle}" />
                <Button
                    Width="200"
                    Command="{Binding DrawSudokuCommand}"
                    CommandParameter="{Binding SelectedSudokuBoardSize}"
                    Content="{Extensions:Localize Main_Draw}" />
                <Button Command="{Binding SolveSudokuCommand}" Content="{Extensions:Localize Main_Solve}" />
                <Button Command="{Binding SaveSudokuCommand}" Content="{Extensions:Localize Main_Save}" />
                <Button Command="{Binding LoadSudokuCommand}" Content="{Extensions:Localize Main_Load}" />
                <Label
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="{Binding Source={x:Static Classes:LocalizationService.Instance}, Path=[Main_SolutionsCounter]}"
                    FontSize="18"
                    Foreground="AntiqueWhite"
                    Visibility="{Binding IsSolutionCounterVisible, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Label
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="{Binding SolutionCounter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    FontSize="18"
                    Foreground="AntiqueWhite"
                    Visibility="{Binding IsSolutionCounterVisible, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Center"
                DockPanel.Dock="Bottom"
                Orientation="Horizontal">
                <Button
                    Width="50"
                    Height="50"
                    Command="{Binding LoadPreviousSolutionCommand}"
                    Style="{StaticResource IconButtonStyle}">
                    <Image Source="../../Resources/Icons/LeftArrow.png" />
                </Button>
                <Button
                    Width="50"
                    Height="50"
                    Command="{Binding LoadNextSolutionCommand}"
                    Style="{StaticResource IconButtonStyle}">
                    <Image Source="../../Resources/Icons/RightArrow.png" />
                </Button>
            </StackPanel>
            <ContentControl Content="{Binding SudokuBoardControl, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
    </wpfx:BusyIndicator>
</UserControl>