<UserControl x:Class="Solvedoku.Views.TabControlWithRightContentArea.UcTabControlWithRightContentArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ClassicSudokuControls="clr-namespace:Solvedoku.Views.ClassicSudoku"
             xmlns:JigsawSudokuControls="clr-namespace:Solvedoku.Views.JigsawSudoku" 
             xmlns:CustomTab="clr-namespace:Solvedoku.CustomControls.TabControlWithRightContentArea"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CustomTab:TabControlWithRightContentArea x:Name="TcSudokus" Grid.Row="0" Margin="4" Background="Gray" HorizontalAlignment="Center" Style="{StaticResource TabControlWithRightContentAreaStyle}">
            <CustomTab:TabControlWithRightContentArea.RightAreaContent>
                <Button Background="Red" Content="asdasd"/>
            </CustomTab:TabControlWithRightContentArea.RightAreaContent>
            <TabItem x:Name="tabItem" Header="Klasszikus">
                <ClassicSudokuControls:UcClassicSudoku/>
            </TabItem>
            <TabItem Header="Puzzle">
                <JigsawSudokuControls:UcJigsawSudoku/>
            </TabItem>
        </CustomTab:TabControlWithRightContentArea>
    </Grid>
</UserControl>