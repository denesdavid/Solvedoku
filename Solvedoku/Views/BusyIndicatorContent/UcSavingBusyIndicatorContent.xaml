<UserControl
    x:Class="Solvedoku.Views.BusyIndicatorContent.UcSavingBusyIndicatorContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Classes="clr-namespace:Solvedoku.Classes"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <System:Boolean x:Key="FalseValue">False</System:Boolean>
        <System:Boolean x:Key="TrueValue">True</System:Boolean>
        <LinearGradientBrush x:Key="BusyIProgressBarBackground" StartPoint="1,0" EndPoint="1,1.75">
            <GradientStop Offset="0.555" Color="ForestGreen" />
            <GradientStop Offset="-0.111" Color="LightGreen" />
        </LinearGradientBrush>
        <Style x:Key="ProgressBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="IsIndeterminate" Value="True" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Background" Value="LightGray" />
            <Setter Property="Foreground" Value="{StaticResource BusyIProgressBarBackground}" />
            <Setter Property="Margin" Value="8,8,8,8" />
        </Style>
    </UserControl.Resources>
    <Grid
        MinWidth="150"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <StackPanel Margin="4">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="{Classes:Loc MessageBox_SavingInProgress}" />
            <StackPanel Margin="4">
                <Border Grid.Row="1" CornerRadius="40">
                    <ProgressBar Style="{StaticResource ProgressBarStyle}" />
                </Border>
                <StackPanel HorizontalAlignment="Center">
                    <Button
                        Margin="4"
                        HorizontalAlignment="Stretch"
                        Command="{Binding CancelBusySavingCommand}"
                        CommandParameter="{StaticResource TrueValue}"
                        Content="{Classes:Loc Button_Cancel}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>