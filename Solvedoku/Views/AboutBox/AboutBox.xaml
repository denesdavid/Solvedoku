<Window
    x:Class="Solvedoku.Views.AboutBox.AboutBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AboutBoxViewModel="clr-namespace:Solvedoku.ViewModels.AboutBoxWindow"
    xmlns:Classes="clr-namespace:Solvedoku.Classes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="800"
    Height="450"
    Margin="16"
    AllowsTransparency="True"
    Background="Transparent"
    MouseDown="Window_MouseDown"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.DataContext>
        <AboutBoxViewModel:AboutBoxViewModel />
    </Window.DataContext>
    <Grid Background="LightGray">
        <Grid.Effect>
            <DropShadowEffect
                BlurRadius="200"
                Direction="-60"
                Opacity="0.4"
                ShadowDepth="90" />
        </Grid.Effect>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Label
            Grid.Row="0"
            Margin="8"
            Content="{Binding Title}"
            FontSize="25" />
        <Label
            Grid.Row="1"
            Margin="8"
            Content="{Binding Version}"
            FontSize="25" />
        <Label
            Grid.Row="2"
            Margin="8"
            Content="{Classes:Loc AboutBox_DevelopedByDD}"
            FontSize="25" />
        <TextBlock
            Grid.Row="4"
            Margin="16"
            FontSize="18"
            Text="{Classes:Loc AboutBox_Description}"
            TextAlignment="Justify"
            TextWrapping="Wrap" />
        <Button
            Grid.Row="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Content="OK"
            IsCancel="True" />
    </Grid>
</Window>