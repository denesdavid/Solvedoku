<UserControl
    x:Class="Solvedoku.Views.TabControlWithRightContentArea.UcTabControlWithRightContentArea"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Extensions="clr-namespace:Solvedoku.UI.Extensions"
    xmlns:ClassicSudokuControls="clr-namespace:Solvedoku.Views.ClassicSudoku"
    xmlns:CustomTab="clr-namespace:Solvedoku.CustomControls.TabControlWithRightContentArea"
    xmlns:JigsawSudokuControls="clr-namespace:Solvedoku.Views.JigsawSudoku"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CustomTab:TabControlWithRightContentArea
            x:Name="TcSudokus"
            Grid.Row="0"
            Margin="4"
            HorizontalAlignment="Center"
            Background="Gray"
            Style="{StaticResource TabControlWithRightContentAreaStyle}">
            <CustomTab:TabControlWithRightContentArea.RightContentArea>
                <StackPanel Orientation="Horizontal">
                    <Button
                        Margin="5"
                        Click="Options_Click"
                        Style="{StaticResource ImageButtonStyle}">
                        <Image
                            Width="30"
                            Height="30"
                            RenderOptions.EdgeMode="Aliased"
                            Source="../../Resources/Icons/GearWheel.png"
                            ToolTip="{Extensions:Localize ToolTip_Settings}">
                            <Image.Style>
                                <Style TargetType="{x:Type Image}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect
                                                        BlurRadius="15"
                                                        Opacity="1"
                                                        RenderingBias="Quality"
                                                        ShadowDepth="-10"
                                                        Color="SkyBlue" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Button>
                    <Button
                        Margin="5"
                        Click="About_Click"
                        Style="{StaticResource ImageButtonStyle}">
                        <Image
                            Width="30"
                            Height="30"
                            RenderOptions.EdgeMode="Aliased"
                            Source="../../Resources/Icons/About.png"
                            ToolTip="{Extensions:Localize ToolTip_About}">
                            <Image.Style>
                                <Style TargetType="{x:Type Image}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect
                                                        BlurRadius="15"
                                                        Opacity="1"
                                                        RenderingBias="Quality"
                                                        ShadowDepth="-10"
                                                        Color="SkyBlue" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Button>
                </StackPanel>
            </CustomTab:TabControlWithRightContentArea.RightContentArea>
            <TabItem x:Name="tabItem" Header="Klasszikus">
                <ClassicSudokuControls:UcClassicSudoku />
            </TabItem>
            <TabItem Header="Puzzle">
                <JigsawSudokuControls:UcJigsawSudoku />
            </TabItem>
        </CustomTab:TabControlWithRightContentArea>
    </Grid>
</UserControl>